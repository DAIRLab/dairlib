DAIRLIB_COMPONENTS = [
    "//common:common",
    "//lcm:lcm",
    "//multibody:multibody", 
    "//systems:systems",
    "//solvers:solvers",
]

package(default_visibility = ["//visibility:public"])

# Filegroup collecting all headers
filegroup(
    name = "dairlib_headers",
    srcs = [
        "//common:headers",
        "//lcm:headers",
        "//multibody:headers", 
        "//systems:headers",
        "//systems/controllers:headers",
        "//systems/framework:headers",
        "//systems/primitives:headers",
        "//systems/trajectory_optimization:headers",
        "//systems/filters:headers",
        "//systems/controllers/osc:headers",
        "//solvers:headers",
    ],
)

# Combined target that provides both the shared library and headers
cc_library(
    name = "dairlib",
    hdrs = [":dairlib_headers"],
    deps = DAIRLIB_COMPONENTS + [
        "//lcmtypes:lcmt_robot",
        "@drake//:drake_shared_library",
        "@eigen",
        "@gflags",
        "@lcm",
    ],
    include_prefix = "dairlib",
    visibility = ["//visibility:public"],
)