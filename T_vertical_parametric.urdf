<?xml version="1.0"?>
<robot name="cube" xmlns:drake="https://drake.mit.edu/">
    <link name="body">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.37" />
            <inertia
                ixx="0.00081"
                ixy="0"
                ixz="0"
                iyy="0.00081"
                iyz="0"
                izz="0.00081"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="examples/sampling_c3/urdf/push_t_white.obj"/>
            </geometry>
            <material name="pennred">
                <color rgba="0.6 0 0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="examples/sampling_c3/urdf/push_t_white.obj"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <drake:proximity_properties>
                <drake:mu_static value="0.15" />
            </drake:proximity_properties>
        </collision>
    </link>

    <link name="corner_0">
        <inertial>
        <origin rpy="0 0 0" xyz="0.2 0 -0.02"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0"
            ixy="0"
            ixz="0"
            iyy="0"
            iyz="0"
            izz="0"/>
        </inertial>
        <visual>
        <origin rpy="0 0 0" xyz="0.2 0 -0.02"/>
        <geometry>
            <sphere radius="0.01"/>
        </geometry>
        </visual>
        <collision name="sphere">
            <origin rpy="0 0 0" xyz="0.2 0 -0.02"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
                <drake:proximity_properties>
                <drake:mu_static value="1"/>
                <drake:mu_dynamic value="1"/>
            </drake:proximity_properties>
        </collision>
        <contact>
                    <lateral_friction value="0.0"/>
                    <rolling_friction value="0.0"/>
                    <contact_cfm value="0.0"/>
                    <contact_erp value="0.0"/>
        </contact>
    </link>

    <link name="corner_1">
        <inertial>
        <origin rpy="0 0 0" xyz="-0.2 -0.2 -0.02"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0"
            ixy="0"
            ixz="0"
            iyy="0"
            iyz="0"
            izz="0"/>
        </inertial>
        <visual>
        <origin rpy="0 0 0" xyz="-0.2 -0.2 -0.02"/>
        <geometry>
            <sphere radius="0.01"/>
        </geometry>
        </visual>
        <collision name="sphere">
            <origin rpy="0 0 0" xyz="-0.2 -0.2 -0.02"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
                <drake:proximity_properties>
                <drake:mu_static value="1"/>
                <drake:mu_dynamic value="1"/>
            </drake:proximity_properties>
        </collision>
        <contact>
                    <lateral_friction value="0.0"/>
                    <rolling_friction value="0.0"/>
                    <contact_cfm value="0.0"/>
                    <contact_erp value="0.0"/>
        </contact>
    </link>

    <link name="corner_2">
        <inertial>
        <origin rpy="0 0 0" xyz="-0.2 0.2 -0.02"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0"
            ixy="0"
            ixz="0"
            iyy="0"
            iyz="0"
            izz="0"/>
        </inertial>
        <visual>
        <origin rpy="0 0 0" xyz="-0.2 0.2 -0.02"/>
        <geometry>
            <sphere radius="0.01"/>
        </geometry>
        </visual>
        <collision name="sphere">
            <origin rpy="0 0 0" xyz="-0.2 0.2 -0.02"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
                <drake:proximity_properties>
                <drake:mu_static value="1"/>
                <drake:mu_dynamic value="1"/>
            </drake:proximity_properties>
        </collision>
        <contact>
                    <lateral_friction value="0.0"/>
                    <rolling_friction value="0.0"/>
                    <contact_cfm value="0.0"/>
                    <contact_erp value="0.0"/>
        </contact>
    </link>

</robot>
