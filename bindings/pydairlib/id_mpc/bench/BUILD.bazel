package(default_visibility = ["//visibility:public"])

load(
    "@drake//tools/skylark:pybind.bzl",
    "get_pybind_package_info",
)

py_binary(
    name = "alip_bench",
    srcs = ["alip_bench.py"],
    data = [],
    deps = [
        ":utils",
        "//bindings/pydairlib/perceptive_locomotion:diagrams_py",
        "//bindings/pydairlib/systems",
    ],
)

py_binary(
    name = "alip_bench_analysis",
    srcs = ["alip_bench_analysis.py"],
    data = [],
    deps = [
        ":utils",
        "//bindings/pydairlib/analysis:cassie_plotting_utils",
        "//bindings/pydairlib/analysis:process_lcm_log",
        "//bindings/pydairlib/geometry:convex_polygon_py",
        "//bindings/pydairlib/systems",
        "//lcmtypes:lcmtypes_robot_py",
    ],
)

py_library(
    name = "utils",
    srcs = ["utils.py"],
    deps = [],
)

# This determines how `PYTHONPATH` is configured, and how to install the
# bindings.
PACKAGE_INFO = get_pybind_package_info("//bindings")

py_library(
    name = "module_py",
    srcs = [
        "__init__.py",
    ],
    imports = PACKAGE_INFO.py_imports,
    deps = [
        "//bindings/pydairlib:module_py",
    ],
)

PY_LIBRARIES = [
    ":utils",
]

# Package roll-up (for Bazel dependencies).
py_library(
    name = "bench",
    imports = PACKAGE_INFO.py_imports,
    deps = PY_LIBRARIES,
)
