package(default_visibility = ["//visibility:public"])

cc_library(
    name = "common",
    deps = [
        ":math_utils",
        ":discrete_time_filter",
        ":eigen_utils",
        ":file_utils",
        ":find_resource",
        ":quaternion_error_hessian",
        ":update_context",
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "find_resource",
    srcs = ["find_resource.cc"],
    hdrs = [
        "find_resource.h",
    ],
    deps = [
        "//third_party/spruce",
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "eigen_utils",
    srcs = ["eigen_utils.cc"],
    hdrs = [
        "eigen_utils.h",
    ],
    deps = [
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "file_utils",
    srcs = [
        "file_utils.cc",
    ],
    hdrs = [
        "file_utils.h",
    ],
    deps = [
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "math_utils",
    srcs = [
        "math_utils.cc",
    ],
    hdrs = [
        "math_utils.h",
    ],
    deps = [
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "discrete_time_filter",
    srcs = [
        "discrete_time_filter.cc",
    ],
    hdrs = [
        "discrete_time_filter.h",
    ],
    deps = [
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "quaternion_error_hessian",
