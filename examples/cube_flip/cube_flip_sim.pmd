group "controllers" {
    cmd "plate_controller" {
        exec = "bazel-bin/examples/cube_flip/franka_plate_controller";
        host = "localhost";
    }
    cmd "franka_osc" {
        exec = "bazel-bin/examples/cube_flip/franka_plate_osc_controller";
        host = "localhost";
    }
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "localhost";
    }
}

group "operator" {
    cmd "plate_trajectory_visualizer" {
        exec = "bazel-bin/examples/cube_flip/trajectory_visualizer_plate";
        host = "localhost";
    }

    cmd "hand_trajectory_visualizer" {
        exec = "bazel-bin/examples/cube_flip/trajectory_visualizer_hand";
        host = "localhost";
    }

    cmd "point_hand_trajectory_visualizer" {
        exec = "bazel-bin/examples/cube_flip/trajectory_visualizer_point_hand";
        host = "localhost";
    }

    cmd "point_hand_trajectory_slider" {
        exec = "bazel-bin/examples/cube_flip/trajectory_visualizer_point_hand_slider";
        host = "localhost";
    }

    cmd "visualizer" {
        exec = "bazel-bin/examples/cube_flip/franka_plate_visualizer";
        host = "localhost";
    }

    cmd "xbox" {
        exec = "bazel-bin/examples/cube_flip/xbox_script";
        host = "localhost";
    }
}

group "logging" {
	cmd "start_logging" {
			exec = "python3 examples/cube_flip/start_logging.py sim /home/ericcui/logs";
			host = "localhost";
	}


	cmd "view_logs" {
			exec = "/opt/lcm/1.4.0/bin/lcm-logplayer-gui -f PMD.*";
			host = "localhost";
	}
}

group "simulations" {
    cmd "franka_sim" {
        exec = "bazel-bin/examples/cube_flip/franka_plate_sim";
        host = "localhost";
    }
}


script "setup"{
    restart cmd "franka_sim";
    restart cmd "franka_osc";
}
