      <!-- ========================= -->
      <!-- FINGER 1 -->
      <!-- ========================= -->
      <link name="fingertip_1">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>8e-6</ixx>
          <iyy>8e-6</iyy>
          <izz>8e-6</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.01</radius>
            </sphere>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.01</radius>
            </sphere>
          </geometry>
          <drake:proximity_properties>
            <drake:mu_static>0.5</drake:mu_static>
            <drake:mu_dynamic>0.5</drake:mu_dynamic>
          </drake:proximity_properties>
        </collision>
      </link>

      <link name="base_link_1">
        <inertial>
          <mass>1.0e-6</mass>
