      </link>
      <joint name="joint_x_1" type="prismatic">
        <parent>base_link_1</parent>
        <child>link_x_1</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <effort>5.0 </effort>
            <velocity>0.5</velocity>
            <lower> -0.05 </lower>
