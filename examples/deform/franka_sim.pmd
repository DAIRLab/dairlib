group "simulations" {
    cmd "simulator" {
        exec = "bazel run examples/multibody/deformable/elastoplastic --config=omp --";
        host = "mpm_sim";
    }
}

group "operator" {
    cmd "visualizer" {
        exec = "bazel-bin/examples/deform/franka_visualizer --is_simulation=true";
        host = "localhost";
    }
    cmd "radio_GUI" {
        exec = "python examples/deform/test/radio.py";
        host = "localhost";
    }
    cmd "xbox" {
        exec = "bazel-bin/examples/deform/xbox_script --is_simulation=true";
        host = "localhost";
    }
    cmd "start_logging" {
        exec = "python examples/deform/start_logging.py sim /mnt/data0/bibit/logs/";
        host = "localhost";
    }
}

group "controllers" {
    cmd "franka_osc" {
        exec = "bazel-bin/examples/deform/franka_osc_controller --is_simulation=true";
        host = "localhost";
    }
    cmd "sampling_c3" {
        exec = "bazel-bin/examples/deform/franka_deform_controller --is_simulation=true";
        host = "localhost";
    }
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "localhost";
    }
}


script "start_experiment_no_logs"{
    stop cmd "start_logging";
    restart cmd "franka_osc";
    restart cmd "sampling_c3";
    wait ms 50;
    restart cmd "simulator";
}

script "end_experiment"{
    stop cmd "simulator";
    stop cmd "sampling_c3";
    stop cmd "franka_osc";
}
