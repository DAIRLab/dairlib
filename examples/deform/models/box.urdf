<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE:  For use with MPM-based simulation, this file needs to stay in sync
with that located at:
  mpm_drake/drake/examples/multibody/deformable/models/box.urdf
-->
<!-- Models a fictional box in the Franka environment so the MPM dough exists in
the positive y and z halfspaces.  The origin z height is set to align with the
world's z=0 plane. -->
<robot name="box">
  <link name="box">
    <visual>
      <origin xyz="0 0 0.0355" />
      <geometry>
        <box size="0.4 0.4 0.129"/>
      </geometry>
      <material>
        <color rgba="0.6 0.6 0.6 0.9"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0355" />
      <geometry>
        <box size="0.4 0.4 0.129"/>
      </geometry>
      <drake:proximity_properties>
        <drake:mesh_resolution_hint value="0.01"/>
        <drake:mu_static value="1"/>
        <drake:mu_dynamic value="1"/>
      </drake:proximity_properties>
    </collision>
  </link>
</robot>
