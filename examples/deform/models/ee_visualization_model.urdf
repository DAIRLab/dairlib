<?xml version="1.0" ?>
<robot name="end_effector_simple">
  <link name="base_link" />
  <link name="end_effector_simple">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
    </inertial>
   <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <!-- Use slightly larger radius for visualization purposes. -->
        <sphere radius="0.0198"/>
      </geometry>
      <material>
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0195"/>
      </geometry>
      <drake:proximity_properties>
        <drake:mu_static value="1"/>
        <drake:mu_dynamic value="1"/>
      </drake:proximity_properties>
    </collision>
  </link>

  <link name="pt_fake_x" />
  
  <link name="pt_fake_y" />
  
  <joint name="x" type="prismatic">
    <parent link="base_link"/>
    <child link="pt_fake_x"/>
    <axis xyz="1 0 0"/>
  </joint>
  <joint name="y" type="prismatic">
    <parent link="pt_fake_x"/>
    <child link="pt_fake_y"/>
    <axis xyz="0 1 0"/>
  </joint>
    <joint name="z" type="prismatic">
    <parent link="pt_fake_y"/>
    <child link="end_effector_simple"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
