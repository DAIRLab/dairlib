group "controllers" {
    cmd "trifinger_180_hybrid_mpc_controller" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_hybrid_mpc_controller --example_idx=1";
        host = "localhost";
    }
    cmd "trifinger_pivot_hybrid_mpc_controller" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_hybrid_mpc_controller --example_idx=2";
        host = "localhost";
    }

    cmd "trifinger_osc" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_osc_controller";
        host = "localhost";
    }
    cmd "trifinger_180_controller" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_controller --example_idx=1";
        host = "localhost";
    }
    cmd "trifinger_pivot_controller" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_controller --example_idx=2";
        host = "localhost";
    }

    cmd "trifinger_180_traj_controller" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_traj_controller --example_idx=1";
        host = "localhost";
    }
    cmd "trifinger_pivot_traj_controller" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_traj_controller --example_idx=2";
        host = "localhost";
    }

}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "localhost";
    }
}

group "operator" {
    cmd "visualizer" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_visualizer";
        host = "localhost";
    }
    cmd "xbox" {
        exec = "bazel-bin/examples/iC3/xbox_script";
        host = "localhost";
    }
}

group "simulations" {
    cmd "trifinger_sim" {
        exec = "bazel-bin/examples/iC3/trifinger/trifinger_sim";
        host = "localhost";
    }
}

group "logging" {
	cmd "start_logging" {
			exec = "python3 examples/iC3/start_logging.py sim /home/ericcui/logs";
			host = "localhost";
	}


	cmd "view_logs" {
			exec = "/opt/lcm/1.4.0/bin/lcm-logplayer-gui -f PMD.*";
			host = "localhost";
	}
}

script "setup"{
    restart cmd "trifinger_sim";
    restart cmd "trifinger_osc";
}
