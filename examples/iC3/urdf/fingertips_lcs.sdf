          <geometry>
            <sphere>
              <radius>0.01</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.01</radius>
            </sphere>
          </geometry>
          <drake:proximity_properties>
            <drake:mu_static>0.6</drake:mu_static>
            <drake:mu_dynamic>0.6</drake:mu_dynamic>
          </drake:proximity_properties>
        </collision>
      </link>

      <link name="base_link_1">
        <inertial>
