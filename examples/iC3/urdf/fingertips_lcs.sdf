<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="hand_world">

    <model name="fingertips_lcs">
      <!-- HARDCODED JOINT LIMITS -->


      <!-- ========================= -->
      <!-- FINGER 1 -->
      <!-- ========================= -->
      <link name="fingertip_1">
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>8e-7</ixx>
          <iyy>8e-7</iyy>
          <izz>8e-7</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
