load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "urdfs",
    data = glob([
        "urdf/**",
    ]),
)

cc_library(
    name = "mujoco_xml",
    data = glob([
        "mujoco_xml/**/*",
    ]),
)

filegroup(
    name = "all_parameter_yamls",
    data = glob(["parameters/*.yaml"]),
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "round_belt_sim",
    srcs = [
        "round_belt_sim.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    deps = [
        "//common:find_resource",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:sim_params",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
)

cc_binary(
    name = "round_belt_visualizer",
    srcs = [
        "round_belt_visualizer.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    deps = [
        "//common:eigen_utils",
        "//common:find_resource",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:round_belt_controller_params",
        "//examples/magna/parameter_headers:visualizer_params",
        "//examples/magna/systems/franka_hand:franka_hand_status_bridge_out",
        "//examples/magna/systems/visualization:c3_belt_state_drawer",
        "//examples/magna/systems/visualization:deformable_drawer",
        "//lcmtypes:lcmt_robot",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//systems/visualization:lcm_visualization_systems",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
)

cc_binary(
    name = "franka_osc_controller",
    srcs = [
        "franka_osc_controller.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    linkopts = select({
        "@platforms//os:macos": [
            "-L/opt/homebrew/opt/openblas/lib",
            "-lopenblas",
        ],
        "@platforms//os:linux": ["-lopenblas"],
        "//conditions:default": [],
    }),
    deps = [
        "//common",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:osc_params",
        "//lcm:lcm_trajectory_saver",
        "//systems:franka_hand_target_position_receiver",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//systems/controllers:gravity_compensator",
        "//systems/controllers/osc:end_effector_force",
        "//systems/controllers/osc:end_effector_orientation",
        "//systems/controllers/osc:end_effector_position",
        "//systems/controllers/osc:operational_space_control",
        "//systems/framework:lcm_driven_loop",
        "//systems/trajectory_optimization:lcm_trajectory_systems",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
)

cc_binary(
    name = "franka_hand_osc_controller",
    srcs = [
        "franka_hand_osc_controller.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    deps = [
        "//common",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:osc_params",
        "//examples/magna/systems/utils:simulation_utils",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//systems/controllers/osc:operational_space_control",
        "//systems/framework:lcm_driven_loop",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
)

cc_library(
    name = "assembly_controller",
    srcs = [
        "assembly_controller.cc",
    ],
    hdrs = [
        "assembly_controller.h",
    ],
    deps = [
        "//common:update_context",
        "//examples/magna/parameter_headers:assembly_c3_options",
        "//examples/magna/parameter_headers:round_belt_controller_params",
        "//examples/magna/parameter_headers:target_poses",
        "//lcm:lcm_trajectory_saver",
        "//lcmtypes:lcmt_robot",
        "//solvers:c3",
        "//solvers:c3_output",
        "//solvers:lcs",
        "//systems/trajectory_optimization:c3_output_systems",
        "@drake//:drake_shared_library",
    ],
)

cc_binary(
    name = "run_assembly_controller",
    srcs = [
        "run_assembly_controller.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    deps = [
        ":assembly_controller",
        "//common:find_resource",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:round_belt_controller_params",
        "//examples/magna/systems/force_elements:linear_spring_damper_no_compression",
        "//systems:franka_kinematics",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//systems/framework:lcm_driven_loop",
        "//systems/senders:c3_state_sender",
        "@gflags",
    ],
)

py_binary(
    name = "xbox_script",
    srcs = ["xbox_script.py"],
    data = [
        "@lcm//:lcm-python",
    ],
    main = "xbox_script.py",
    deps = [
        "//lcmtypes:lcmtypes_robot_py",
    ],
)
