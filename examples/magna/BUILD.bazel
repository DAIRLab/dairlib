package(default_visibility = ["//visibility:private"])

cc_library(
    name = "urdfs",
    data = glob([
        "urdf/**",
    ]),
)

cc_library(
    name = "mujoco_xml",
    data = glob([
        "mujoco_xml/**/*",
    ]),
)

filegroup(
    name = "all_parameter_yamls",
    visibility = ["//visibility:public"],
    data = glob(["parameters/*.yaml"]),
)

cc_binary(
    name = "round_belt_sim",
    srcs = [
        "round_belt_sim.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    deps = [
        "//common:find_resource",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:sim_params",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
)

cc_binary(
    name = "round_belt_visualizer",
    srcs = [
        "round_belt_visualizer.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    deps = [
        "//common:find_resource",
        "//common:eigen_utils",
        ":deformable_drawer",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:visualizer_params",
        "//lcmtypes:lcmt_robot",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
)

cc_binary(
    name = "franka_osc_controller",
    srcs = [
        "franka_osc_controller.cc",
    ],
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    deps = [
        "//examples/magna/parameter_headers:lcm_channel_params",
        "//examples/magna/parameter_headers:osc_params",
        "//common",
        "//lcm:lcm_trajectory_saver",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//systems/controllers:gravity_compensator",
        "//systems/controllers/osc:operational_space_control",
        "//systems/controllers/osc:end_effector_position",
        "//systems/controllers/osc:end_effector_orientation",
        "//systems/controllers/osc:end_effector_force",
        "//systems/framework:lcm_driven_loop",
        "//systems/trajectory_optimization:lcm_trajectory_systems",
        "//systems:franka_hand_target_position_receiver",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
    linkopts = [
        "-L/lib/x86_64-linux-gnu",
        "-lopenblas",
    ],
)

cc_library(
    name = "deformable_drawer",
    srcs = [
        "deformable_drawer.cc",
    ],
    hdrs = [
        "deformable_drawer.h",
    ],
    deps = [
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "assembly_controller",
    srcs = [
        "assembly_controller.cc",
    ],
    hdrs = [
        "assembly_controller.h",
    ],
    deps = [
        "//common:update_context",
        "//lcm:lcm_trajectory_saver",
        "//lcmtypes:lcmt_robot",
        "//solvers:c3",
        "//solvers:lcs",
        "@drake//:drake_shared_library",
        "//examples/magna/parameter_headers:assembly_c3_options",
        "//examples/magna/parameter_headers:target_poses",
    ],
)

cc_binary(
    name = "run_assembly_controller",
    data = [
        ":all_parameter_yamls",
        ":urdfs",
        "@drake_models//:franka_description",
    ],
    srcs = [
        "run_assembly_controller.cc",
    ],
    deps = [
        "//systems/framework:lcm_driven_loop",
        "//systems:franka_kinematics",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//common:find_resource",
        ":assembly_controller",
        "//examples/magna/parameter_headers:lcm_channel_params",
        "@gflags//:gflags",
    ],
)
