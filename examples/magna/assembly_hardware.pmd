group "operator" {
    cmd "visualizer" {
        exec = "bazel-bin/examples/magna/round_belt_visualizer --is_simulation=false --lcm_url=udpm://239.255.76.67:7667?ttl=1";
        host = "control_pc";
    }
}

group "controllers" {    
    cmd "assembly" {
        exec = "bazel-bin/examples/magna/run_assembly_controller --lcm_url=udpm://239.255.76.67:7667?ttl=1";
        host = "control_pc";
    }
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "control_pc";
    }
}
