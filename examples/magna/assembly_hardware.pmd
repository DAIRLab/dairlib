group "operator" {
    cmd "visualizer" {
        exec = "bazel-bin/examples/magna/round_belt_visualizer";
        host = "control_pc";
    }
}

group "controllers" {    
    cmd "assembly" {
        exec = "bazel-bin/examples/magna/run_assembly_controller";
        host = "control_pc";
    }
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "control_pc";
    }
}
