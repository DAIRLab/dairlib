group "simulations" {
    cmd "franka_hand_simulation" {
        exec = "bazel-bin/examples/magna/franka_hand_simulation";
        host = "localhost";
    }
    cmd "franka_simulation" {
        exec = "bazel-bin/examples/magna/franka_simulation";
        host = "localhost";
    }
    cmd "visualizer" {
        exec = "bazel-bin/examples/magna/franka_visualizer";
        host = "localhost";
    }
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "localhost";
    }
}

group "controller (spacemouse)" {
    cmd "franka_cartesian_osc" {
        exec = "bazel-bin/examples/magna/franka_cartesian_osc_controller --is_spacemouse=true";
        host = "localhost";
    }
}

group "controller (trajectory)" {
    cmd "franka_cartesian_osc" {
        exec = "bazel-bin/examples/magna/franka_cartesian_osc_controller";
        host = "localhost";
    }
}