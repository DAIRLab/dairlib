<?xml version="1.0"?>
<sdf version="1.7">
  <model name="t_shape">    
    <link name="horizontal_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <!-- Inertia values were calculated to be consistent with the mass and
             geometry size, assuming a uniform density. -->
        <inertia>
            <ixx>0.000075</ixx>
            <iyy>0.0006375</iyy>
            <izz>0.0006375</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="horizontal_link">
        <geometry>
          <box>
            <size>0.12 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <diffuse>0 1 0 1</diffuse>
        </material>
      </visual>
      <collision name="horizontal_link_volume">
            <geometry>
          <box>
            <size>0.12 0.03 0.03</size>
          </box>
        </geometry>
        <drake:proximity_properties>
        <!-- <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus> 3.0e7 </drake:hydroelastic_modulus>
        <drake:mesh_resolution_hint> 0.18 </drake:mesh_resolution_hint>
        <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation> -->
        <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>   
    </link>

    <link name="vertical_link">
      <inertial>
        <pose>0 0.075 0 0 0 1.5708</pose>
        <mass>0.5</mass>
        <!-- Inertia values were calculated to be consistent with the mass and
             geometry size, assuming a uniform density. -->
        <inertia>
            <ixx>0.000075</ixx>
            <iyy>0.0006375</iyy>
            <izz>0.0006375</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="vertical_link">
        <pose>0 0.075 0 0 0 1.5708</pose>
        <geometry>
          <box>
            <size>0.12 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
      <collision name="vertical_link_volume">
        <pose>0 0.075 0 0 0 1.5708</pose>
            <geometry>
          <box>
            <size>0.12 0.03 0.03</size>
          </box>
        </geometry>
        <drake:proximity_properties>
        <!-- <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus> 3.0e7 </drake:hydroelastic_modulus>
        <drake:mesh_resolution_hint> 0.18 </drake:mesh_resolution_hint>
        <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation> -->
        <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>   
    </link>


    <link name="corner_xnynz">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0</mass>
        <inertia>
          <ixx>0.</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.</iyy>
          <iyz>0</iyz>
          <izz>0.</izz>
        </inertia>
      </inertial>
    <collision name="corner_xnynz_">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>
        <drake:proximity_properties>
        <!-- <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus> 3.0e7 </drake:hydroelastic_modulus>
        <drake:mesh_resolution_hint> 0.18 </drake:mesh_resolution_hint>
        <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation> -->
        <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>
        <pose> 0.06 -0.015 -0.015 0 0 0</pose>
      </collision>
    <visual name="corner_xnynz">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>
        <material>
        <diffuse>1 0 0 1</diffuse>
        </material>
        <pose> 0.06 -0.015 -0.015 0 0 0</pose>
      </visual>
    </link>


    <link name="corner_nxnynz">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0</mass>
        <inertia>
          <ixx>0.</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.</iyy>
          <iyz>0</iyz>
          <izz>0.</izz>
        </inertia>
      </inertial>
    <collision name="corner_nxnynz">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>
        <drake:proximity_properties>
        <!-- <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus> 3.0e7 </drake:hydroelastic_modulus>
        <drake:mesh_resolution_hint> 0.18 </drake:mesh_resolution_hint>
        <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation> -->
        <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>
        <pose> -0.06 -0.015 -0.015 0 0 0</pose>
      </collision>
    <visual name="corner_nxnynz">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>
        <material>
        <diffuse>1 0 0 1</diffuse>
        </material>
        <pose> -0.06 -0.015 -0.015 0 0 0</pose>
      </visual>
    </link>

    <link name="corner_xynz">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0</mass>
        <inertia>
          <ixx>0.</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.</iyy>
          <iyz>0</iyz>
          <izz>0.</izz>
        </inertia>
      </inertial>
    <collision name="corner_xynz">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>
        <drake:proximity_properties>
        <!-- <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus> 3.0e7 </drake:hydroelastic_modulus>
        <drake:mesh_resolution_hint> 0.18 </drake:mesh_resolution_hint>
        <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation> -->
        <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>
        <pose> 0.0 0.135 -0.015 0 0 0</pose>
      </collision>
    <visual name="corner_xynz">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>
        <material>
        <diffuse>1 0 0 1</diffuse>
        </material>
        <pose> 0.0 0.135 -0.015 0 0 0</pose>
      </visual>
    </link>

    <joint name="fixed_joint" type="fixed">
      <!-- Parent and child links for the joint -->
      <parent>horizontal_link</parent>
      <child>vertical_link</child>
      <!-- Pose of the joint relative to the parent link -->
      <pose>0 0 0 0 0 0</pose>
    </joint>    

    <joint name="corner_xnynz_joint" type="fixed">
      <!-- Parent and child links for the joint -->
      <parent>horizontal_link</parent>
      <child>corner_xnynz</child>
      <!-- Pose of the joint relative to the parent link -->
      <pose>0 0 0 0 0 0</pose>
    </joint>  
    
    <joint name="corner_nxnynz_joint" type="fixed">
      <!-- Parent and child links for the joint -->
      <parent>horizontal_link</parent>
      <child>corner_nxnynz</child>
      <!-- Pose of the joint relative to the parent link -->
      <pose>0 0 0 0 0 0</pose>
    </joint>  
    
    <joint name="corner_xynz_joint" type="fixed">
      <!-- Parent and child links for the joint -->
      <parent>vertical_link</parent>
      <child>corner_xynz</child>
      <!-- Pose of the joint relative to the parent link -->
      <pose>0 0 0 0 0 0</pose>
    </joint>  
      
  </model>
</sdf>