group "simulations" {
    cmd "franka_sim" {
        exec = "bazel-bin/examples/sampling_c3/franka_sim --demo_name=anything";
        host = "localhost";
    }
}

group "operator" {
    cmd "visualizer" {
        exec = "bazel-bin/examples/sampling_c3/franka_visualizer --is_simulation=true --demo_name=anything";
        host = "localhost";
    }
    cmd "drake-director" {
        exec = "bazel-bin/director/drake-director";
        host = "localhost";
    }
    cmd "xbox" {
        exec = "bazel-bin/examples/sampling_c3/xbox_script";
        host = "localhost";
    }
    cmd "move_to_target_joints" {
        exec = "bazel-bin/examples/sampling_c3/move_to_target_joint_positions";
        host = "localhost";
    }
    cmd "start_logging" {
        exec = "python3 examples/sampling_c3/start_logging.py sim anything /home/ericcui/logs";
        host = "localhost";
    }

    cmd "generate_files" {
        exec = "python3 examples/sampling_c3/sampling_generation/full_script.py";
        host = "localhost";
    }
    cmd "multi_rewrite" {
        exec = "python3 examples/sampling_c3/multiyaml_rewrite.py";
        host = "localhost";
    }
    cmd "install_dependencies" {
        exec = "pip install -r examples/sampling_c3/sampling_generation/python_requirements.txt";
        host = "localhost";
    }
}

group "controllers" {    
    cmd "move_to_init" {
        exec = "bazel-bin/examples/sampling_c3/franka_joint_osc_controller --is_simulation=true --demo_name=anything";
        host = "localhost";
    }
    cmd "franka_osc" {
        exec = "bazel-bin/examples/sampling_c3/franka_osc_controller --is_simulation=true --demo_name=anything";
        host = "localhost";
    }
    cmd "sampling_c3" {
        exec = "bazel-bin/examples/sampling_c3/franka_sampling_c3_controller --is_simulation=true --demo_name=anything";
        host = "localhost";
    }
}
script "init_experiment" {
    stop cmd "franka_sim";
    stop cmd "franka_osc";
    stop cmd "sampling_c3";
    wait ms 1000;
    start cmd "move_to_init";
    start cmd "franka_sim";
    wait ms 10000;
    stop cmd "franka_sim";
    stop cmd "move_to_init";
}

script "move_to_target_joints" {
    stop cmd "franka_sim";
    stop cmd "franka_osc";
    stop cmd "sampling_c3";
    stop cmd "move_to_init";
    wait ms 1000;
    start cmd "move_to_init";
    start cmd "franka_sim";
    wait ms 10000;
    start cmd "move_to_target_joints";
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "localhost";
    }
}

script "start_experiment_no_logs"{
    stop cmd "start_logging";
    start cmd "multi_rewrite";
    wait ms 1000;
    restart cmd "franka_sim";
    restart cmd "franka_osc";
    restart cmd "visualizer";
    wait ms 50;
    restart cmd "sampling_c3";
}

script "start_experiment_with_logs"{
    restart cmd "start_logging";
    restart cmd "franka_sim";
    restart cmd "franka_osc";
    restart cmd "visualizer";
    wait ms 50;
    restart cmd "sampling_c3";
}

script "end_experiment"{
    stop cmd "sampling_c3";
    stop cmd "franka_osc";
    stop cmd "franka_sim";
    wait ms 10;
    stop cmd "start_logging";
}
