group "operator" {
  cmd "visualizer" {
    exec =
        "bazel-bin/examples/sampling_c3/three_d_printer_visualizer --is_simulation=false --demo_name=cone";
    host = "localhost";
  }
  cmd "xbox" {
    exec = "bazel-bin/examples/sampling_c3/xbox_script";
    host = "localhost";
  }
  cmd "logger" {
    exec = "python3 examples/sampling_c3/start_logging.py hw three_d_printer/cone /mnt/data0/three_d_printer/logs";
    host = "localhost";
  }
}

group "controllers (hardware)" {
  cmd "three_d_printer_osc" {
    exec = "bazel-bin/examples/sampling_c3/three_d_printer_osc_controller --is_simulation=false --demo_name=cone --lcm_url=udpm://239.255.76.67:7667?ttl=1";
    host = "localhost";
  }
  cmd "sampling_c3" {
    exec = "bazel-bin/examples/sampling_c3/three_d_printer_sampling_c3_controller --is_simulation=false --demo_name=cone --lcm_url=udpm://239.255.76.67:7667?ttl=1";
    host = "localhost";
  }
}

group "debug" {
  cmd "lcm-spy" {
    exec = "bazel-bin/lcmtypes/dair-lcm-spy";
    host = "localhost";
  }
}

group "drivers" {
  cmd "printer_driver" {
    exec = "python printer_driver.py";
    host = "printer_driver_host";
  }
}

group "object tracking" {
  cmd "object_tracking" {
    exec = "python /mnt/data0/three_d_printer/FoundationPose/run_live_demo.py --system=diamond";
    host = "vision_host";
  }
}

group "printer operations" {
  cmd "print_part_1" {
    exec = "/home/three_d_printer/printer_robot_driver/two_part_print.py --model diamond --part1";
    host = "printer_driver_host";
  }
  cmd "push_and_attach" {
    exec = "/home/three_d_printer/printer_robot_driver/two_part_print.py --model diamond --push-and-attach";
    host = "printer_driver_host";
  }
  cmd "detach_and_part2" {
    exec = "/home/three_d_printer/printer_robot_driver/two_part_print.py --model diamond --detach-and-part2";
    host = "printer_driver_host";
  }
}

script "start operator commands" {
  restart cmd "visualizer";
  restart cmd "xbox";
  restart cmd "lcm-spy";
}

script "step 1:  print part 1" {
  stop cmd "print_part_1";
  stop cmd "push_and_attach";
  stop cmd "detach_and_part2";
  stop cmd "logger";
  stop cmd "object_tracking";
  stop cmd "printer_driver";
  stop cmd "three_d_printer_osc";
  stop cmd "sampling_c3";
  wait ms 1000;
  start cmd "print_part_1";

}

script "step 2:  transition to controller" {
  stop cmd "print_part_1";
  start cmd "logger";
  wait ms 50;
  start cmd "object_tracking";
  wait ms 1000;
  start cmd "push_and_attach";
  start cmd "printer_driver";
  wait ms 1000;
  start cmd "three_d_printer_osc";
  wait ms 1000;
  start cmd "sampling_c3";
}

script "step 3:  transition out of controller; print part 2" {
  stop cmd "push_and_attach";
  stop cmd "sampling_c3";
  stop cmd "three_d_printer_osc";
  stop cmd "object_tracking";
  stop cmd "printer_driver";
  stop cmd "logger";
  wait ms 1000;
  start cmd "detach_and_part2";
}

script "end experiment" {
  stop cmd "print_part_1";
  stop cmd "push_and_attach";
  stop cmd "detach_and_part2";
  stop cmd "logger";
  stop cmd "object_tracking";
  stop cmd "printer_driver";
  stop cmd "three_d_printer_osc";
  stop cmd "sampling_c3";
}
