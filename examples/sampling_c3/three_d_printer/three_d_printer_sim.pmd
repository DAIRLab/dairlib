group "simulations" {
    cmd "three_d_printer_sim" {
        exec = "bazel-bin/examples/sampling_c3/three_d_printer_sim --demo_name=three_d_printer";
        host = "localhost";
    }
}

group "operator" {
    cmd "visualizer" {
        exec = "bazel-bin/examples/sampling_c3/three_d_printer_visualizer --is_simulation=true --demo_name=three_d_printer";
        host = "localhost";
    }
    cmd "xbox" {
        exec = "bazel-bin/examples/sampling_c3/xbox_script";
        host = "localhost";
    }
    cmd "radio_GUI" {
        exec = "python examples/sampling_c3/test/radio.py";
        host = "localhost";
    }
    cmd "start_logging" {
        exec = "python3 examples/sampling_c3/start_logging.py sim three_d_printer /home/bibit/3d_printer/logs";
        host = "localhost";
    }
}

group "controllers" {
    cmd "three_d_printer_osc" {
        exec = "bazel-bin/examples/sampling_c3/three_d_printer_osc_controller --is_simulation=true --demo_name=three_d_printer";
        host = "localhost";
    }
    cmd "sampling_c3" {
        exec = "bazel-bin/examples/sampling_c3/three_d_printer_sampling_c3_controller --is_simulation=true --demo_name=three_d_printer";
        host = "localhost";
    }
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "localhost";
    }
}

script "init_experiment" {
    stop cmd "three_d_printer_sim";
    stop cmd "three_d_printer_osc";
    stop cmd "sampling_c3";
    wait ms 1000;
    start cmd "three_d_printer_sim";
    wait ms 10000;
    stop cmd "three_d_printer_sim";
}

script "start_experiment_no_logs"{
    stop cmd "start_logging";
    wait ms 1000;
    restart cmd "three_d_printer_sim";
    restart cmd "three_d_printer_osc";
    wait ms 50;
    restart cmd "sampling_c3";
}

script "start_experiment_with_logs"{
    restart cmd "start_logging";
    restart cmd "three_d_printer_sim";
    restart cmd "three_d_printer_osc";
    wait ms 50;
    restart cmd "sampling_c3";
}

script "end_experiment"{
    stop cmd "sampling_c3";
    stop cmd "three_d_printer_osc";
    stop cmd "three_d_printer_sim";
    wait ms 10;
    stop cmd "start_logging";
}
