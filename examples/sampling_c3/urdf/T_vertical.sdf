<?xml version="1.0"?>
<sdf version="1.7">
  <model name="t_shape">    
    <link name="vertical_link">
      <inertial>
        <pose>-0.05 0 0 0 0 0</pose>
        <mass>1</mass>
        <!-- Inertia values were calculated to be consistent with the mass and
             geometry size, assuming a uniform density. -->
