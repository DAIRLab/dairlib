<?xml version="1.0"?>
<sdf version="1.7">
  <model name="cone">

    <link name="cone">

      <inertial>
        <pose>0.0126 0 0 0 0 0</pose>

        <!-- Example mass -->
        <mass>0.0345</mass>

        <!-- Solid cube inertia:
             I = (1/6) m a²
             a = 0.0254 m
             m = 0.0345 kg
        -->
        <inertia>
          <ixx>5.3763e-06</ixx>
          <iyy>5.3763e-06</iyy>
          <izz>5.3763e-06</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="cone_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
  <mesh>
      <uri>cone.obj</uri>
    </mesh>
</geometry>

        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <collision name="cone_collision">
        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <mesh>
      <uri>cone.obj</uri>
    </mesh>
        </geometry>

        <drake:proximity_properties xmlns:drake="uri:drake">
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>3.0e7</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.025</drake:mesh_resolution_hint>
          <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>

      </collision>

      <visual name="corner_0">
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>1 0 0 1</diffuse>
        </material>

        <pose>0 -0.0254 0 0 0 0</pose>
      </visual>
      <visual name="corner_1">
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>0 1 0 1</diffuse>
        </material>

        <pose>0 0.0254 0 0 0 0</pose>
      </visual>
      <visual name="corner_2">
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>0 0 1 1</diffuse>
        </material>

        <pose>0 -0.0127 -0.022 0 0 0</pose>
      </visual>
      <visual name="corner_3">
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>1 1 0 1</diffuse>
        </material>

        <pose>0 -0.0127 0.022 0 0 0</pose>
      </visual>
      <visual name="corner_4">
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>1 0 1 1</diffuse>
        </material>

        <pose>0 0.0127 0.022 0 0 0</pose>
      </visual>
      <visual name="corner_5">
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>0 1 1 1</diffuse>
        </material>

        <pose>0 0.0127 -0.022 0 0 0</pose>
      </visual>
      <visual name="corner_6">
        <geometry>
          <sphere>
            <radius>0.005</radius>
          </sphere>
        </geometry>

        <material>
          <diffuse>1 1 1 1</diffuse>
        </material>

        <pose> 0.0494 0 0 0 0 0</pose>
      </visual>

    </link>

  </model>
</sdf>