          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>

        <drake:proximity_properties>
          <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>

        <pose>0 -0.0127 -0.022 0 0 0</pose>
      </collision>
      <collision name="corner_3">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>

        <drake:proximity_properties>
          <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>

        <pose>0 -0.0127 0.022 0 0 0</pose>
      </collision>
      <collision name="corner_4">
