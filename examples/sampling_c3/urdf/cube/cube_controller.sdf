<?xml version="1.0"?>
<sdf version="1.7">

  <model name="cube">

    <link name="cube">

      <inertial>
        <pose>0 0 0 0 0 0</pose>

        <mass>1.00</mass>

        <inertia>
  <ixx>0.003</ixx>
  <iyy>0.003</iyy>
  <izz>0.006</izz>
  <ixy>0</ixy>
  <ixz>0</ixz>
  <iyz>0</iyz>
</inertia>
      </inertial>

      <visual name="cube_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
  <box>
    <size>0.0508 0.0508 0.0508</size>
  </box>
</geometry>

        <material>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>

      <collision name="cube_collision">
        <pose>0 0 0 0 0 0</pose>

        <geometry>
  <box>
    <size>0.0508 0.0508 0.0508</size>
  </box>
</geometry>

        <drake:proximity_properties xmlns:drake="uri:drake">
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>3.0e7</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.025</drake:mesh_resolution_hint>
          <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>

      <!-- Bottom corners used by the controller -->

      <collision name="corner_0">
        <geometry>
          <sphere>
            <radius>0.001</radius>
          </sphere>
        </geometry>

        <drake:proximity_properties>
          <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>

        <pose>-0.0254 -0.0254 -0.0254 0 0 0</pose>
      </collision>

      <collision name="corner_1">
        <geometry>
          <sphere>
