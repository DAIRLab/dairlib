<?xml version="1.0" encoding="utf-8"?>
<robot name="ee">
  <material name="black">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>

  <!-- Only the simulator loads this model.  The masses are a real finger's
       (a few grams): with sim_params' compliant_finger, the whole model rides
       the deflection springs, and a heavy EE snaps into the 34.5 g cone like
       a hammer when a bent finger lets go. -->
  <link name="end_effector_flange">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.003"/>
      <inertia
        ixx="2.8e-6" ixy="0.0" ixz="0.0"
        iyy="1.6e-6" iyz="0.0"
        izz="4.4e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.105 0.008664"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.105 0.008664"/>
      </geometry>
    </collision>
  </link>

  <link name="end_effector_peg">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.002"/>
      <inertia
        ixx="1.7e-6" ixy="0.0" ixz="0.0"
        iyy="1.7e-6" iyz="0.0"
        izz="1.6e-8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="flange_to_peg" type="fixed">
     <origin rpy="0 0 0" xyz="0 -0.0084 -0.052"/>
     <parent link="end_effector_flange"/>
     <child link="end_effector_peg"/>
  </joint>

  <link name="end_effector_tip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.003"/>
      <inertia
        ixx="1.2e-7" ixy="0.0" ixz="0.0"
        iyy="1.2e-7" iyz="0.0"
        izz="1.2e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <drake:proximity_properties>
        <drake:point_contact_stiffness value="1e7"/>
      </drake:proximity_properties>
    </collision>
  </link>

  <joint name="flange_to_tip" type="fixed">
     <origin rpy="0 0 0" xyz="0 -0.0084 -0.109332"/>
     <parent link="end_effector_flange"/>
     <child link="end_effector_tip"/>
  </joint>
</robot>
