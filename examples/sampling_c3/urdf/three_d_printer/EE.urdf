<?xml version="1.0" encoding="utf-8"?>
<robot name="ee">
  <material name="black">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>

  <link name="end_effector_flange">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.105 0.008664"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.105 0.008664"/>
      </geometry>
    </collision>
  </link>

  <link name="end_effector_peg">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="flange_to_peg" type="fixed">
     <origin rpy="0 0 0" xyz="0 -0.0084 -0.052"/>
     <parent link="end_effector_flange"/>
     <child link="end_effector_peg"/>
  </joint>

  <link name="end_effector_tip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.0005" ixy="0.0" ixz="0.0"
        iyy="0.0005" iyz="0.0"
        izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <drake:proximity_properties>
        <drake:point_contact_stiffness value="1e7"/>
      </drake:proximity_properties>
    </collision>
  </link>

  <joint name="flange_to_tip" type="fixed">
     <origin rpy="0 0 0" xyz="0 -0.0084 -0.109332"/>
     <parent link="end_effector_flange"/>
     <child link="end_effector_tip"/>
  </joint>
</robot>
