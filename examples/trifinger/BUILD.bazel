cc_library(
    name = "trifinger_goal_generator",
    srcs = ["trifinger_goal_generator.cc"],
    hdrs = ["trifinger_goal_generator.h"],
    deps = [
        "//examples/sampling_c3/parameter_headers:goal_params",
        "//systems/framework:vector",
        "//lcmtypes:lcmt_robot",
        "//lcm:lcm_trajectory_saver",
        "//common:math_utils",
        "@drake//:drake_shared_library",
        "@lcm",
    ],
