<?xml version="1.0" ?>
<robot name="truth_d8"
  xmlns:drake="https://drake.mit.edu/">
    <link name="cube">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5" />
            <inertia
                ixx="0.5"
                ixy="0"
                ixz="0"
                iyy="0.5"
                iyz="0"
                izz="0.5"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="meshes/d8_5cm_mmscale.obj"/>
            </geometry>
            <material name="pennred">
                <color rgba="0.6 0 0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="meshes/d8_5cm_mmscale.obj"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <drake:proximity_properties>
                <drake:mu_static value="0.05" />
                <drake:rigid_hydroelastic />
                <drake:mesh_resolution_hint value="0.001" />
                <drake:point_contact_stiffness value="10800.0" />
                <drake:hunt_crossley_dissipation value="0.4" />
            </drake:proximity_properties>
        </collision>
    </link>
</robot>