group "simulations" {
    cmd "trifinger_sim" {
        exec = "bazel-bin/examples/trifinger/trifinger_sampling_sim";
        host = "localhost";
    }
}

group "operator" {
    cmd "visualizer" {
        exec = "bazel-bin/examples/trifinger/trifinger_sampling_visualizer";
        host = "localhost";
    }
    cmd "drake-director" {
        exec = "bazel-bin/director/drake-director";
        host = "localhost";
    }
}

group "controllers" {    
    cmd "trifinger_osc" {
        exec = "bazel-bin/examples/trifinger/trifinger_sampling_osc_controller";
        host = "localhost";
    }
    cmd "sampling_c3" {
        exec = "bazel-bin/examples/trifinger/trifinger_sampling_c3_controller";
        host = "localhost";
    }
}

group "debug" {
    cmd "lcm-spy" {
        exec = "bazel-bin/lcmtypes/dair-lcm-spy";
        host = "localhost";
    }
}

script "start_experiment_no_logs"{
    stop cmd "start_logging";
    restart cmd "trifinger_sim";
    restart cmd "trifinger_osc";
    wait ms 50;
    restart cmd "sampling_c3";
}


script "end_experiment"{
    stop cmd "sampling_c3";
    stop cmd "trifinger_osc";
    stop cmd "trifinger_sim";
    wait ms 10;
}
