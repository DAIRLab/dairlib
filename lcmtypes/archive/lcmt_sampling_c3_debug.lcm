package archive.dairlib;

/* The lcmt_sampling_c3_debug layout as it stood BEFORE jam_object_travel was
   added (2026-09-22).  Kept only so the logs already on disk stay readable:
   LCM verifies the fingerprint on decode, so every log recorded between the
   jam watchdog landing and the travel term -- the 2026-09-17 hardware logs and
   the 2026-09-22 realistic-sim logs the travel thresholds were scored on --
   fails to decode against the current type.

   Python analysis of an old log therefore reads
       from archive import dairlib as archive_dairlib
       archive_dairlib.lcmt_sampling_c3_debug.decode(event.data)
   instead of the current dairlib.lcmt_sampling_c3_debug.  C++ does not need
   this: hybrid_jam_replay.cc upgrades old payloads in place (UpgradeIfNeeded).

   Do not edit this file.  It is a record of a past wire format, not a type
   anything still publishes.

   mode_switch_reason and source_of_pursued_target keys are as documented in
   lcmtypes/lcmt_sampling_c3_debug.lcm.
*/

struct lcmt_sampling_c3_debug
{
  int64_t utime;

  boolean is_c3_mode;

  boolean is_teleop;
  boolean is_force_tracking;
  boolean is_forced_into_c3;

  boolean in_pose_tracking_mode;

  int32_t mode_switch_reason;
  int32_t source_of_pursued_target;

  int32_t detected_goal_changes;

  int32_t best_progress_steps_ago;

  float lowest_cost;
  float lowest_pos_and_rot_current_cost;
  float lowest_position_error;
  float lowest_orientation_error;

  float current_pos_error;
  float current_rot_error;

  float jam_ee_object_force;
  float jam_ee_object_gap;
  boolean jam_tripped;
}
