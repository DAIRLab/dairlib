package archive.dairlib;

/* Archived generation of lcmt_sampling_c3_debug:  jam_unload_distance, but
   none of the load tier's fields (added 2026-10-01).  Reads the 2026-09-29
   and 2026-09-30 logs that carry jam_unload_distance.

   lcmtype with debug information for the sampling controller.

    mode_switch_reason key:
        0: No mode switch
        1: Switch to C3 because lower cost
        2: Switch to C3 because reached repositioning target
        3: Switch to repositioning because found lower cost sample
        4: Switch to repositioning because unproductive in C3
        5: Switch to C3 because xbox controller forced into C3 mode
        6: Switch to repositioning because a jam was detected
        7: Switch to repositioning because the goal changed

    source_of_pursued_target key:
        0: No pursued target (i.e. in C3 mode)
        1: Previous repositioning target
        2: New sample
        3: Sample from buffer

    repos_target_decision key (only meaningful while repositioning; an actual
    repos -> repos switch is exactly 3 or 4, since nominating a challenger
    deliberately leaves the target alone):
        0: Kept incumbent target, nothing nominated
        1: Kept incumbent target, challenger nominated this loop
        2: Kept incumbent target, pending nominee lost its re-score
        3: Retargeted to the nominee after it confirmed
        4: Retargeted because the incumbent is in penetration
        5: Kept incumbent target, pending nominee lost its re-score, and
           another of this loop's samples was nominated in its place

    mode_switch_decision key (the nominate-then-confirm gates on cost-driven
    C3 <-> repositioning switches; nominating deliberately leaves the mode
    alone, so an actual gated switch is exactly 3 or 6):
        0: No gated decision this loop
        1: Stayed in C3, repositioning target nominated this loop
        2: Stayed in C3, pending repositioning nominee lost its re-score
        3: Switched to repositioning after the nominee confirmed
        4: Stayed repositioning, switch to C3 nominated this loop
        5: Stayed repositioning, pending switch to C3 lost its re-score
        6: Switched to C3 after the nomination confirmed
        7: Stayed in C3, pending repositioning nominee lost its re-score, and
           another of this loop's samples was nominated in its place
*/

struct lcmt_sampling_c3_debug_v7
{
  int64_t utime;

  boolean is_c3_mode;

  boolean is_teleop;
  boolean is_force_tracking;
  boolean is_forced_into_c3;

  boolean in_pose_tracking_mode;

  int32_t mode_switch_reason;
  int32_t source_of_pursued_target;

  int32_t detected_goal_changes;

  int32_t best_progress_steps_ago;

  float lowest_cost;
  float lowest_pos_and_rot_current_cost;
  float lowest_position_error;
  float lowest_orientation_error;

  float current_pos_error;
  float current_rot_error;

  float jam_ee_object_force;
  float jam_ee_object_gap;
  boolean jam_tripped;
  float jam_object_travel;

  int32_t repos_target_decision;

  int32_t mode_switch_decision;

  // The EE<->object gap measured from the printer's reported EE position
  // rather than the predicted one [m], and whether the jam guard's deep tier
  // armed on it this loop.
  float jam_ee_object_gap_measured;
  boolean jam_deep_armed;

  // The jam guard's estimate of a compliant finger's deflection [m]: the
  // horizontal distance from the reported EE back to where its gap last read
  // non-negative.  NaN before the EE has been seen outside the object.
  float jam_unload_distance;
}
