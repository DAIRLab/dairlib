package dairlib;

/*  Measured DenseTact Contact Data
*/

struct lcmt_densetact_measurement
{
  int64_t timestamp;
  boolean inContact;
  double contactFrame [4][4];
  double scaledNormal;
  double scaledFriction [2];
}

struct lcmt_densetact_measurement_data
{
  int8_t numSensors;
  lcmt_densetact_measurement sensorData [numSensors];
}
