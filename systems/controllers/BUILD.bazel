        "//examples/sampling_c3/parameter_headers:reposition_params",
        "//examples/sampling_c3/parameter_headers:progress_params",
        "//common:update_context",
        "@c3//:libc3",
        "@c3//core:traj_eval",
        "@drake//:drake_shared_library",
    ] + select({
        "@platforms//os:macos": ["@libomp"],
        "//conditions:default": [],
    }),
)

