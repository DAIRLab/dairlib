    hdrs = ["id_mpc_walking_system.h"],
    deps = [
        ":mpc_solution",
        "//lcmtypes:lcmt_robot",
        "//multibody:utils",
        "//systems/controllers/id_mpc",
        "//solvers/sqp",
        "//systems/controllers/id_mpc/walking:id_mpc_walking",
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "constant_reference_system",
    srcs = ["constant_reference_system.cc"],
    hdrs = ["constant_reference_system.h"],
    deps = [
        "//systems/controllers/id_mpc/references:id_mpc_references",
