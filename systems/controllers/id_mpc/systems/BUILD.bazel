load("@drake//tools/lint:lint.bzl", "add_lint_tests")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "id_mpc_systems",
    deps = [
        ":constant_reference_system",
        ":id_mpc_system",
        ":id_mpc_walking_system",
    ],
)

cc_library(
    name = "id_mpc_system",
    srcs = ["id_mpc_system.cc"],
    hdrs = ["id_mpc_system.h"],
    deps = [
        ":mpc_solution",
        "//lcmtypes:lcmt_robot",
        "//systems/controllers/id_mpc",
        "//solvers/sqp",
        "@drake//:drake_shared_library",
    ],
)

cc_library(
    name = "id_mpc_walking_system",
